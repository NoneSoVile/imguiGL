---
# C++ files and headers treated as C++
If:
  PathMatch: ".*\\.(cpp|cc|cxx|hpp|hxx|hh|h)$"

CompileFlags:
  Add:
    - "--target=x86_64-pc-windows-msvc"
    - "-std=c++20"
    - "-fms-extensions"
    - "-fms-compatibility"
    - "-fdelayed-template-parsing"
    - "-D_MT"
    - "-D_DLL"
    - "-I${workspaceFolder}/include"
    - "-I${workspaceFolder}/include/imgui"
    - "-I${workspaceFolder}/include/Graphics"
    - "-I${workspaceFolder}/include/Utilities"
    - "-I${workspaceFolder}/include/LinearMath"
    - "-I${workspaceFolder}/include/kinematics"
    - "-I${workspaceFolder}/include/3dmodel_loader"
    - "-ID:/vcpkg/vcpkg/installed/x64-windows/include"
    - "-ID:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/include"
    - "-ID:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/ucrt"
    - "-ID:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/shared"
    - "-ID:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/um"
    - "-DUNICODE"
    - "-D_UNICODE"
    - "-D_CRT_SECURE_NO_WARNINGS"
  Remove:
    - "-W*"

---
# Pure C sources
If:
  PathMatch: ".*\\.c$"

CompileFlags:
  Add:
    - "--target=x86_64-pc-windows-msvc"
    - "-std=c17"
    - "-fms-extensions"
    - "-fms-compatibility"
    - "-D_MT"
    - "-D_DLL"
    - "-I${workspaceFolder}/include"
    - "-I${workspaceFolder}/include/imgui"
    - "-I${workspaceFolder}/include/Graphics"
    - "-I${workspaceFolder}/include/Utilities"
    - "-I${workspaceFolder}/include/LinearMath"
    - "-I${workspaceFolder}/include/kinematics"
    - "-I${workspaceFolder}/include/3dmodel_loader"
    - "-ID:/vcpkg/vcpkg/installed/x64-windows/include"
    - "-ID:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/include"
    - "-ID:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/ucrt"
    - "-ID:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/shared"
    - "-ID:/Program Files (x86)/Windows Kits/10/Include/10.0.22621.0/um"
    - "-DUNICODE"
    - "-D_UNICODE"
    - "-D_CRT_SECURE_NO_WARNINGS"
  Remove:
    - "-W*"

---
Index:
  Background: Build

InlayHints:
  Enabled: true
  ParameterHints: true
  TypeHints: true
  DeducedTypes: true

Hover:
  ShowAKA: true

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict





